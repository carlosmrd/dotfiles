# Logs and runtime state
**/*.log
**/logs/
**/OpenTabletDriver/Logs/

# Secrets and credentials
**/sunshine_state.json
**/credentials/
**/sizes.ors

# Machine-generated state
**/fish_variables
**/prefixes/
**/*.backup*
**/*.bak
openrgb/.config/OpenRGB/OpenRGB.json

# Fisher-managed plugins (land in the repo through the symlinked fish dir)
fish/.config/fish/fish_plugins
fish/.config/fish/functions/
fish/.config/fish/conf.d/
fish/.config/fish/completions/

# Noctalia-generated GTK/Qt theme outputs (templates managed via config.toml)
**/gtk-3.0/noctalia.css
**/gtk-4.0/noctalia.css
**/gtk-3.0/gtk.css
**/gtk-4.0/gtk.css

# Noctalia-generated app theme outputs (regenerated on config-reload, except noctalia.kdl)
btop/.config/btop/themes/noctalia.theme
fastfetch/.config/fastfetch/themes/noctalia.jsonc
kitty/.config/kitty/themes/noctalia.conf
zed/.config/zed/themes/noctalia.json

# OS/editor noise
.DS_Store
**/.DS_Store
