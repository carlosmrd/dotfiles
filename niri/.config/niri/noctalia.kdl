layout {

    focus-ring {
        active-color   "#ffb59d"
        inactive-color "#1d100c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb59d"
        inactive-color "#1d100c"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb59d"
        inactive-color "#f66028"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb59d80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb59d"
        urgent-color "#ffb4ab"
    }
}
